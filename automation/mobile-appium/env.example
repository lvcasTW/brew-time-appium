# Copie para .env e exporte antes do pytest, ou defina no shell.

# Servidor Appium 2
APPIUM_SERVER=http://127.0.0.1:4723

# Android: um dos dois modos
# Modo A — instalar APK a cada sessão (recomendado em CI)
# BREWTIME_APP=/caminho/absoluto/app-debug.apk

# Modo B — app já instalado no emulador/dispositivo
BREWTIME_APP_PACKAGE=com.brewtime.app
BREWTIME_APP_ACTIVITY=.MainActivity

# Dispositivo (pytest-xdist: use BREWTIME_UDID_GW0 / BREWTIME_UDID_GW1)
BREWTIME_UDID=emulator-5554
BREWTIME_UDID_GW0=emulator-5554
BREWTIME_UDID_GW1=emulator-5556

BREWTIME_IMPLICIT_WAIT=8
